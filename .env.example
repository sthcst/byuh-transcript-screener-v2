# OpenAI API Configuration
REACT_APP_OPENAI_API_KEY=sk-...
REACT_APP_OPENAI_MODEL=gpt-4-turbo-preview

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/byuh_screener

# Authentication
JWT_SECRET=your-secret-key-min-32-characters
JWT_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=your-aes-256-key-64-hex-characters

# Environment
NODE_ENV=development
REACT_APP_API_URL=http://localhost:3001

# Audit Logging
LOG_RETENTION_YEARS=7
LOG_STORAGE_PATH=./logs

# Compliance
FERPA_MODE=enabled
DATA_MINIMIZATION=enabled
